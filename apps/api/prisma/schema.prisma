generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  blocked
  deleted
}

enum WorkSessionStatus {
  open
  closed
}

enum ClientType {
  individual
  company
}

enum ClientStatus {
  active
  inactive
  archived
}

enum ClientContactType {
  phone
  email
  telegram
  max
  whatsapp
  other
}

enum LeadStatus {
  new
  assigned
  in_progress
  converted
  closed
}

enum IntegrationType {
  site
  app
  avito
  vk
  telegram
  email
  tender_parser
  parser
  agent
  onec
  other
}

enum IntegrationStatus {
  active
  disabled
}

// Tender funnel from the product spec: found -> ... -> closing, with two exits.
enum TenderStatus {
  found
  analysis
  product_check
  pricing
  documents
  submitted
  awaiting_result
  won
  contract
  delivery
  closing
  lost
  declined
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  fullName       String         @map("full_name")
  email          String         @unique
  phone          String?
  passwordHash   String         @map("password_hash")
  roleId         String         @map("role_id") @db.Uuid
  role           Role           @relation(fields: [roleId], references: [id])
  status         UserStatus     @default(active)
  avatarUrl      String?        @map("avatar_url")
  lastLoginAt    DateTime?      @map("last_login_at")
  lastLogoutAt   DateTime?      @map("last_logout_at")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  createdBy      String?        @map("created_by") @db.Uuid
  updatedBy      String?        @map("updated_by") @db.Uuid
  refreshTokens  RefreshToken[]
  workSessions   WorkSession[]
  activityLogs   ActivityLog[]
  assignedClients Client[]       @relation("ClientResponsible")
  assignedLeads   Lead[]         @relation("LeadResponsible")
  assignedTenders Tender[]       @relation("TenderResponsible")
  clientComments ClientComment[] @relation("ClientCommentAuthor")
  clientFiles    ClientFile[]    @relation("ClientFileUploader")

  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  code            String           @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model WorkSession {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt      DateTime          @default(now()) @map("login_at")
  logoutAt     DateTime?         @map("logout_at")
  ipAddress    String?           @map("ip_address")
  userAgent    String?           @map("user_agent")
  device       String?
  totalMinutes Int?              @map("total_minutes")
  status       WorkSessionStatus @default(open)

  @@index([userId, status])
  @@map("work_sessions")
}

model ActivityLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id") @db.Uuid
  oldValueJson Json?    @map("old_value_json")
  newValueJson Json?    @map("new_value_json")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@map("activity_logs")
}

model Client {
  id                String          @id @default(uuid()) @db.Uuid
  type              ClientType
  status            ClientStatus    @default(active)
  name              String
  inn               String?
  kpp               String?
  ogrn              String?
  legalAddress      String?         @map("legal_address")
  actualAddress     String?         @map("actual_address")
  city              String?
  source            String?
  responsibleUserId String?         @map("responsible_user_id") @db.Uuid
  responsibleUser   User?           @relation("ClientResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  comment           String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")
  createdBy         String?         @map("created_by") @db.Uuid
  updatedBy         String?         @map("updated_by") @db.Uuid
  contacts          ClientContact[]
  comments          ClientComment[]
  files             ClientFile[]
  leads             Lead[]

  @@index([responsibleUserId])
  @@index([status, type])
  @@index([source])
  @@index([city])
  @@map("clients")
}

model Lead {
  id                String     @id @default(uuid()) @db.Uuid
  source            String?
  site              String?
  pageUrl           String?    @map("page_url")
  utmSource         String?    @map("utm_source")
  utmMedium         String?    @map("utm_medium")
  utmCampaign       String?    @map("utm_campaign")
  utmContent        String?    @map("utm_content")
  utmTerm           String?    @map("utm_term")
  name              String?
  phone             String?
  email             String?
  telegram          String?
  message           String?
  productInterest   String?    @map("product_interest")
  city              String?
  ipAddress         String?    @map("ip_address")
  status            LeadStatus @default(new)
  responsibleUserId String?    @map("responsible_user_id") @db.Uuid
  responsibleUser   User?      @relation("LeadResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  clientId          String?    @map("client_id") @db.Uuid
  client            Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  dealId            String?    @map("deal_id") @db.Uuid
  // Set when the lead arrived through the intake API. externalId is the id the
  // source system gave the request: a repeated delivery must not create a second lead.
  integrationId     String?    @map("integration_id") @db.Uuid
  integration       Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  externalId        String?    @map("external_id")
  // Earlier lead with the same phone or email, if one was found on arrival.
  duplicateOfId     String?    @map("duplicate_of_id") @db.Uuid
  receivedAt        DateTime   @default(now()) @map("received_at")
  firstResponseAt   DateTime?  @map("first_response_at")
  closedAt          DateTime?  @map("closed_at")
  closeReason       String?    @map("close_reason")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")
  createdBy         String?    @map("created_by") @db.Uuid
  updatedBy         String?    @map("updated_by") @db.Uuid

  @@unique([integrationId, externalId])
  @@index([status])
  @@index([responsibleUserId])
  @@index([clientId])
  @@index([receivedAt])
  @@index([deletedAt])
  @@index([source])
  @@index([city])
  @@index([phone])
  @@index([email])
  @@map("leads")
}

// An external system allowed to push data into the CRM: a site form, the tender
// parser, a bot. Each one has its own key, so access can be revoked per system.
model Integration {
  id          String            @id @default(uuid()) @db.Uuid
  type        IntegrationType
  name        String
  // Stable short name written into lead.source / tender.source.
  code        String            @unique
  status      IntegrationStatus @default(active)
  // Only the SHA-256 of the key is stored; the key itself is shown once on creation.
  keyHash     String            @unique @map("key_hash")
  keyPrefix   String            @map("key_prefix")
  description String?
  lastSyncAt  DateTime?         @map("last_sync_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  createdBy   String?           @map("created_by") @db.Uuid
  updatedBy   String?           @map("updated_by") @db.Uuid
  logs        IntegrationLog[]
  leads       Lead[]
  tenders     Tender[]

  @@index([status])
  @@map("integrations")
}

model IntegrationLog {
  id            String      @id @default(uuid()) @db.Uuid
  integrationId String      @map("integration_id") @db.Uuid
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  direction     String      @default("incoming")
  operation     String
  status        String
  requestJson   Json?       @map("request_json")
  responseJson  Json?       @map("response_json")
  errorMessage  String?     @map("error_message")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([integrationId, createdAt])
  @@map("integration_logs")
}

model Tender {
  id                 String       @id @default(uuid()) @db.Uuid
  title              String
  tenderNumber       String?      @map("tender_number")
  platform           String?
  url                String?
  customerName       String?      @map("customer_name")
  region             String?
  nmck               Decimal?     @db.Decimal(18, 2)
  publishDate        DateTime?    @map("publish_date")
  submissionDeadline DateTime?    @map("submission_deadline")
  auctionDate        DateTime?    @map("auction_date")
  procurementLaw     String?      @map("procurement_law")
  category           String?
  // Parser's relevance bucket: hot / review / wide.
  priority           String?
  status             TenderStatus @default(found)
  responsibleUserId  String?      @map("responsible_user_id") @db.Uuid
  responsibleUser    User?        @relation("TenderResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  requirements       String?
  result             String?
  margin             Decimal?     @db.Decimal(18, 2)
  comment            String?
  source             String?
  integrationId      String?      @map("integration_id") @db.Uuid
  integration        Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  // "<source>:<number>" as the source system identifies the tender; the key the
  // intake API upserts on.
  externalKey        String?      @unique @map("external_key")
  // Number in the original procurement system, when an aggregator card was resolved.
  officialNumber     String?      @map("official_number")
  officialUrl        String?      @map("official_url")
  documentsUrl       String?      @map("documents_url")
  // Source-specific fields kept as received (match reasons, confidence, ...).
  payloadJson        Json?        @map("payload_json")
  firstSeenAt        DateTime     @default(now()) @map("first_seen_at")
  lastSeenAt         DateTime     @default(now()) @map("last_seen_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")
  createdBy          String?      @map("created_by") @db.Uuid
  updatedBy          String?      @map("updated_by") @db.Uuid

  @@index([status])
  @@index([submissionDeadline])
  @@index([responsibleUserId])
  @@index([deletedAt])
  @@index([officialNumber])
  @@index([priority])
  @@map("tenders")
}

model ClientContact {
  id          String            @id @default(uuid()) @db.Uuid
  clientId    String            @map("client_id") @db.Uuid
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactType ClientContactType @map("contact_type")
  value       String
  isPrimary   Boolean           @default(false) @map("is_primary")
  comment     String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([clientId, contactType])
  @@index([value])
  @@map("client_contacts")
}

model ClientComment {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation("ClientCommentAuthor", fields: [userId], references: [id], onDelete: SetNull)
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@index([userId])
  @@map("client_comments")
}

model ClientFile {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?    @relation("ClientFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  originalName String   @map("original_name")
  storedName   String   @map("stored_name")
  mimeType     String   @map("mime_type")
  size         Int
  storagePath  String   @map("storage_path")
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@index([uploadedById])
  @@map("client_files")
}
