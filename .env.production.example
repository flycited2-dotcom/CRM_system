POSTGRES_USER=crm
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=crm
DATABASE_URL=postgresql://crm:change-this-postgres-password@postgres:5432/crm?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-this-long-random-access-secret
JWT_REFRESH_SECRET=change-this-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeMe123!
OWNER_FULL_NAME=CRM Owner
API_PORT=4000
WEB_ORIGIN=http://localhost
CRM_HTTP_PORT=80
NEXT_PUBLIC_API_URL=/api
CLIENT_UPLOAD_DIR=/app/uploads/clients

# Number of reverse proxies in front of the API (host nginx + container nginx = 2)
TRUST_PROXY_HOPS=2
# Publish /api/docs in production only when explicitly enabled
SWAGGER_ENABLED=false
# Set to true for one seed run to reset the owner password to OWNER_PASSWORD
OWNER_PASSWORD_RESET=false
